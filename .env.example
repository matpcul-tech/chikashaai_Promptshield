# ---------------------------------------------------------------------------
# SHIELD_TENANTS (server-side only)
#
# JSON object mapping a tenant id to its config:
#   { "key": string, "secret": string, "terms": string[], "demo": boolean }
#
#   key    - API key the client must present as "Authorization: Bearer <key>"
#   secret - HMAC-SHA-256 signing secret, minimum 32 characters. Every token
#            the tenant produces is keyed by this secret and by nothing else.
#   terms  - the tenant's protected term dictionary. There is no built-in list.
#   demo   - optional; marks the tenant as a demo tenant in scan responses.
#
# WARNING: this variable must NEVER be given the NEXT_PUBLIC_ prefix. Next.js
# compiles every NEXT_PUBLIC_ variable into the browser bundle, which would
# ship every tenant secret to every visitor.
#
# Rotating a tenant secret changes every token that tenant produces, which
# breaks audit correlation across the rotation boundary. That is by design:
# old tokens cannot be linked to new ones without both keys.
#
# Replace the placeholders below with real values in your local .env; never
# commit real keys or secrets.
SHIELD_TENANTS='{"chickasaw-nation":{"key":"REPLACE_WITH_RANDOM_API_KEY","secret":"REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARS","terms":["REPLACE_WITH_REAL_TERM_LIST"]},"demo":{"key":"REPLACE_WITH_THROWAWAY_DEMO_KEY","secret":"REPLACE_WITH_THROWAWAY_DEMO_SECRET_32_CHARS_MIN","terms":["REPLACE_WITH_FAKE_DEMO_TERMS"],"demo":true}}'

# ---------------------------------------------------------------------------
# Client-side tenant identity for the demo UI.
#
# Anything with the NEXT_PUBLIC_ prefix is public by definition: it is
# compiled into the JavaScript bundle and readable by anyone who loads the
# page. That is exactly why the demo tenant must use a throwaway secret and a
# fake term dictionary, never the real protected term list.
NEXT_PUBLIC_SHIELD_TENANT_ID=demo
NEXT_PUBLIC_SHIELD_TENANT_KEY=REPLACE_WITH_THROWAWAY_DEMO_KEY
